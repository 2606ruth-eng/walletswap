# Copy to .env.local for local web development. These public client settings
# are optional; leave blank to use the demo wallet only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional hosted web origin (HTTPS only). Local Vite uses window.location.origin.
VITE_SUPABASE_AUTH_REDIRECT_URL=
# Official WalletSwap LinkedIn company page (https://www.linkedin.com/company/<slug>). Leave blank to hide the link.
VITE_LINKEDIN_COMPANY_URL=
